# --- Chefly backend environment ---
# Copy to .env for local development. In production these are set in Dokploy.

# Postgres connection string. Defaults to a local SQLite file if unset.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# OpenRouter (OpenAI-compatible) — required for live AI results.
OPENROUTER_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional overrides (sensible defaults baked into config.py):
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# VISION_MODEL=openai/gpt-4o-mini
# RECIPE_MODEL=openai/gpt-4.1-mini
# IMAGE_MODEL=google/gemini-2.5-flash-image

# Auth — CHANGE THIS in production (any long random string).
SECRET_KEY=please-change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080
